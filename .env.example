# API Keys - Copy this to .env and fill in your keys
# Only one API key provider is required. The experimental codex provider
# uses `scagent login chatgpt` / `codex login` instead of an API key.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Groq (fast & cheap open-source models)
GROQ_API_KEY=

# Default provider: anthropic, openai, groq, codex, gemini, or vertex
SCAGENT_PROVIDER=openai

# Default model (optional - uses sensible defaults if not set)
# Examples:
#   anthropic: claude-sonnet-4-20250514
#   openai: gpt-5.4-mini
#   groq: llama-3.3-70b-versatile
#   gemini: gemini-3.5-flash
#   codex: leave SCAGENT_MODEL unset; optionally set SCAGENT_CODEX_MODEL
SCAGENT_MODEL=gpt-5.4-mini

SCAGENT_BASE_URL=

SCAGENT_VISION_MODEL=
SCAGENT_VISION_BASE_URL=
SCAGENT_VISION_API_KEY=

# Codex provider (experimental; uses ChatGPT/Codex login, not API billing)
# Run first: scagent login chatgpt
# Codex uses SCAGENT_CODEX_MODEL first, then falls back to SCAGENT_MODEL above.
# Leave both unset to use the Codex CLI default for your ChatGPT account/plan.
# SCAGENT_CODEX_MODEL=gpt-5.4

# Per-call output token ceiling (default 8192). This is a CEILING, not a target —
# it does not make the model verbose, it just allows longer single responses
# (e.g. a large annotation write_json that would otherwise truncate mid-call).
# Note: it is also reserved from the context budget, so it must fit within your
# serving backend's max context (for vLLM: --max-model-len minus the prompt).
# 32768 is safe on a 1M-context server; lower it on small-context backends.
# SCAGENT_MAX_OUTPUT_TOKENS=8192

# Max characters of run_code stdout fed back to the model (default 8000). This is
# a separate limit from SCAGENT_MAX_OUTPUT_TOKENS (that caps the MODEL's output;
# this caps a TOOL RESULT's size). Raise it when the model needs to inspect large
# printed structures (e.g. per-cluster annotation evidence) in one call.
# SCAGENT_RUN_CODE_MAX_OUTPUT=8000

# Thinking / reasoning mode
# DeepSeek: 1=on (default), 0=off. Gemini/vLLM (Qwen/Gemma): set 1 for an explicit override.
# SCAGENT_THINKING=1
# DeepSeek: high|max. Gemini: minimal|low|medium|high. Ignored when thinking is off.
# SCAGENT_THINKING_EFFORT=high
# Legacy Gemini token budget; mapped to low/medium/high when SCAGENT_THINKING_EFFORT is unset.
# SCAGENT_THINKING_BUDGET=8000
# Display only: show the model's raw chain-of-thought in the terminal (dimmed).
# 0=hide (default), 1=show. Applies to reasoning models whose CoT arrives in the
# structured reasoning field (e.g. GLM-5.2/Nemotron served with a reasoning parser).
# SCAGENT_SHOW_THINKING=0
# Persist the chain-of-thought to <run_dir>/reasoning.log (1=save, default; 0=off).
# When saved but not shown, a dim one-line breadcrumb points to the log file.
# SCAGENT_SAVE_THINKING=1

# Model-driven inspection (experimental). 1=the model reads inspect_data's
# judgment-free fact sheet and records column roles / species via the
# record_inspection tool, overriding the heuristic. 0=use heuristics (default).
# SCAGENT_MODEL_INSPECTION=0

# Google Vertex AI (SCAGENT_PROVIDER=vertex — uses service account, no per-call API key)
# Requires gcloud CLI and a service account JSON from Google Cloud Console.
# SCAGENT_VERTEX_PROJECT is auto-read from the JSON file if not set.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# SCAGENT_VERTEX_PROJECT=my-gcp-project
# SCAGENT_VERTEX_REGION=us-central1
# Model: SCAGENT_MODEL=gemini-3.5-flash (google/ prefix added automatically)

# Custom base URL for OpenAI-compatible APIs (Together AI, OpenRouter, etc.)
# For DeepSeek: use openai endpoint (tool calling) or /anthropic for Anthropic format
# SCAGENT_BASE_URL=https://api.together.xyz/v1
# SCAGENT_BASE_URL=https://api.deepseek.com          ← OpenAI-compatible (SCAGENT_PROVIDER=openai)
# SCAGENT_BASE_URL=https://api.deepseek.com/anthropic ← Anthropic-compatible (SCAGENT_PROVIDER=anthropic)

# Tavily Search (recommended - primary backend for web_search_docs)
# Get a key from: https://tavily.com/
TAVILY_API_KEY=

# Google Custom Search / Programmable Search (optional backup for web_search_docs)
# Get these from: https://developers.google.com/custom-search/v1/overview
# Free tier: 100 queries/day
# Search scope depends on your Programmable Search Engine configuration (GOOGLE_CX)
GOOGLE_API_KEY=
GOOGLE_CX=

# ============================================================
# AVAILABLE MODELS (April 2026)
# ============================================================
#
# GROQ MODELS (fast & cheap):
# ---------------------------
# Best for tool calling:
#   llama-3.3-70b-versatile    - Recommended for scagent
#   llama-3.1-70b-versatile    - Also very good
#   llama-3.1-8b-instant       - Faster, but less reliable for tools
#
# Other models on Groq:
#   qwen-qwq-32b               - Reasoning focused (not ideal for tools)
#   deepseek-r1-distill-llama-70b - Reasoning model
#
# OPENAI MODELS:
# --------------
# Flagship:
#   gpt-5.4           - Latest flagship, best for complex reasoning & coding
#   gpt-5.4-pro       - Extra compute for harder problems (via Responses API)
#   gpt-5.4-mini      - GPT-5.4 class, faster/cheaper for high-volume
#   gpt-5.4-nano      - Fastest/cheapest for simple high-volume tasks
#
# Previous Gen (still supported):
#   gpt-4o            - Multimodal (text + audio), good for voice apps
#   gpt-4o-mini       - Faster/cheaper gpt-4o
#   gpt-4-turbo       - Previous generation
#
# Reasoning:
#   o3-mini           - Small reasoning model for science/math/coding
#
# ANTHROPIC MODELS:
# -----------------
# Claude 4.6 (Latest):
#   claude-opus-4-6-20260204      - Most capable, sophisticated reasoning
#   claude-sonnet-4-6-20260XXX    - Balanced performance (check docs for date)
#
# Claude 4.5:
#   claude-opus-4-5-20251101      - Previous flagship
#   claude-sonnet-4-5-20250929    - Great for coding, agents, computer use
#   claude-haiku-4-5-20251001     - Fastest, best for scale/efficiency
#
# Claude 4:
#   claude-sonnet-4-20250514      - Default, solid all-around
#   claude-opus-4-20250514        - Previous Opus
#
# DEEPSEEK MODELS (SCAGENT_PROVIDER=openai, SCAGENT_BASE_URL=https://api.deepseek.com):
# --------------------------------------------------------------------------------------
# Set OPENAI_API_KEY to your DEEPSEEK_API_KEY value when using these.
# Both models have 1M context window and 384K max output tokens.
# Both support tool calling and JSON output.
#
#   deepseek-v4-flash  - Fast flagship; thinking (default) and non-thinking mode.
#                        Legacy alias: deepseek-chat (non-thinking), deepseek-reasoner (thinking)
#                        Price: $0.14/1M in (cache miss), $0.28/1M out
#
#   deepseek-v4-pro    - Most capable; stronger reasoning/coding. Thinking mode default.
#                        75% discount through May 31 2026 UTC.
#                        Price: $0.435/1M in (cache miss), $0.87/1M out
#
# Thinking mode: controlled via `thinking: {budget_tokens: N}` in the API call.
# Set budget_tokens=0 to disable thinking (non-thinking mode).
#
# Anthropic-compatible endpoint (SCAGENT_PROVIDER=anthropic):
#   SCAGENT_BASE_URL=https://api.deepseek.com/anthropic
#   Use same model IDs; set ANTHROPIC_API_KEY to your DeepSeek key.
#
# CUSTOM PROVIDERS (via SCAGENT_BASE_URL):
# ----------------------------------------
# Together AI: https://api.together.xyz/v1
#   - Qwen/Qwen2.5-Coder-32B-Instruct
#   - meta-llama/Llama-3.3-70B-Instruct
#
# OpenRouter: https://openrouter.ai/api/v1
#   - qwen/qwen-2.5-coder-32b-instruct
#   - anthropic/claude-3.5-sonnet
#
# LOCAL (vLLM via start_vllm.sh — set SCAGENT_BASE_URL=http://localhost:8000/v1):
# ---------------------------------------------------------------------------------
# Downloaded and ready to serve:
#   Qwen3-32B                 - Best overall: 40K ctx, strong reasoning + thinking mode
#   Qwen2.5-Coder-32B-Instruct - Coding-focused, 128K ctx
#   Qwen2.5-72B-Instruct      - Largest, but only 32K ctx (not recommended for scagent)
#   gemma-4-31b-it            - Google multimodal, 256K native ctx (needs 2+ GPUs)
#
# Examples:
#   bash start_vllm.sh Qwen/Qwen3-32B 8000 2
#   bash start_vllm.sh Qwen/Qwen2.5-Coder-32B-Instruct 8000 1
#   bash start_vllm.sh google/gemma-4-31b-it 8000 4
#
# ============================================================

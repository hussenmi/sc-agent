# scagent shared lab .env  —  lives at <install_prefix>/.env
# Discovered automatically because the module sets SCAGENT_HOME to the install
# dir and scagent's _load_dotenv() searches $SCAGENT_HOME/.env.
#
# Permissions: chmod 640, group grp_hpc_collab002 (group-readable, NOT
# world-readable — it holds a secret key). NEVER commit this file with a real
# key; commit only this template.

# --- LLM provider / model ---
SCAGENT_PROVIDER=anthropic
# SCAGENT_MODEL=

# --- API key (shared lab key) ---
ANTHROPIC_API_KEY=REPLACE_WITH_LAB_KEY
# OPENAI_API_KEY=

# --- Vision sidecar (optional) ---
# SCAGENT_VISION_MODEL=
# SCAGENT_VISION_BASE_URL=
# SCAGENT_VISION_API_KEY=
